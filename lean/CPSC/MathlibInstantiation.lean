import Mathlib.Analysis.Matrix.Exponential
import Mathlib.Analysis.Complex.Basic
import Mathlib.LinearAlgebra.Matrix.Hermitian

open Matrix Complex

/-- Quantum evolution generated by a Hermitian Hamiltonian.
    Specializes the ring-generic matrix exponential (available for any complete normed algebra) to ℂ. -/
noncomputable def QuantumEvolution {n : Type*} [Fintype n] [DecidableEq n] (H : Matrix n n ℂ) (t : ℝ) : Matrix n n ℂ :=
  Matrix.exp (-(Complex.I * t) • H)

/-- Hermitian generators produce unitary evolution.
    This is the bridge from the generic Taylor-series exponential to the unitary group. -/
