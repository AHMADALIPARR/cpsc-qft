import Mathlib.Analysis.Matrix.Exponential
import Mathlib.Analysis.Complex.Basic
import Mathlib.LinearAlgebra.Matrix.Hermitian

open Matrix Complex

/-- Quantum evolution generated by a Hermitian Hamiltonian. -/
noncomputable def QuantumEvolution {n : Type*} [Fintype n] [DecidableEq n]
    (H : Matrix n n ℂ) (t : ℝ) : Matrix n n ℂ :=
  Matrix.exp (-(Complex.I * t) • H)

/-- The generator -i t H is skew-Hermitian. -/
theorem generator_skew_Hermitian {n : Type*} [Fintype n] [DecidableEq n]
    (H : Matrix n n ℂ) (hH : H.Hermitian) (t : ℝ) :
    (-(Complex.I * t) • H).adjoint = -(-(Complex.I * t) • H) := by
  simp [Matrix.smul_adjoint, hH, Complex.conj_I]
  ring

end
